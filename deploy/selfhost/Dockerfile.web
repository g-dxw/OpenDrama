FROM node:22-alpine AS build
ENV NODE_OPTIONS="--max-old-space-size=512 --max-semi-space-size=4"
WORKDIR /src
COPY admin/package*.json ./admin/
COPY web/package*.json ./web/
COPY h5/package*.json ./h5/
RUN cd admin && npm ci && cd ../web && npm ci && cd ../h5 && npm ci
COPY admin/ ./admin/
COPY web/ ./web/
COPY h5/ ./h5/
COPY shared/ ./shared/
RUN cd admin && npm run build && cd ../web && npm run build && cd ../h5 && npm run build

FROM nginx:1.28-alpine
COPY --from=build /src/admin/dist /srv/admin
COPY --from=build /src/web/dist /srv/web
COPY --from=build /src/h5/dist /srv/h5
COPY deploy/selfhost/nginx.conf /etc/nginx/conf.d/default.conf

COPY cli/ /srv/cli/
